<Window x:Class="ImageReviewTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ImageReviewTool.Controls"
        xmlns:infra="clr-namespace:ImageReviewTool.Infrastructure"
        Title="图片复判工具" Width="1500" Height="900" MinWidth="1050" MinHeight="680"
        WindowState="Maximized" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <infra:BoolToVisibilityConverter x:Key="BoolVisibility"/>
    <infra:NullToVisibilityConverter x:Key="NullVisibility"/>
    <infra:SameTagConverter x:Key="SameTag"/>
    <Style x:Key="TagChoiceButton" TargetType="Button">
      <Setter Property="Foreground" Value="#344054"/>
      <Setter Property="Background" Value="#F5F8FC"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="3"/>
      <Setter Property="MinWidth" Value="88"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
        </Trigger>
        <DataTrigger Value="True">
          <DataTrigger.Binding>
            <MultiBinding Converter="{StaticResource SameTag}">
              <Binding Path="DataContext.SelectedItem.DetectionTag" RelativeSource="{RelativeSource AncestorType=Window}"/>
              <Binding Path="."/>
            </MultiBinding>
          </DataTrigger.Binding>
          <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
          <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
          <Setter Property="Foreground" Value="White"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Window.InputBindings>
    <KeyBinding Key="Left" Command="{Binding PreviousCommand}"/>
    <KeyBinding Key="Right" Command="{Binding NextCommand}"/>
  </Window.InputBindings>

  <Grid Background="{StaticResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,0,0,1" Padding="18,12,18,14">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="4,0,4,9">
          <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="8"
                  Background="{StaticResource PrimaryBrush}" Margin="0,0,10,0">
            <TextBlock Text="✓" Foreground="White" FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock Text="图片复判工作台" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="检测结果复核、标签统计与分类导出" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
          </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>

          <TextBlock Text="结果目录" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
          <TextBox Grid.Column="1" Text="{Binding ResultFolder, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Grid.Column="2" Content="浏览..." Command="{Binding BrowseResultCommand}" MinWidth="76"/>
          <TextBlock Grid.Column="3" Text="图片格式" VerticalAlignment="Center" Margin="18,5,5,5" FontWeight="SemiBold"/>
          <ItemsControl Grid.Column="4" ItemsSource="{Binding ImageFormats}" VerticalAlignment="Center" Margin="4,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="5,3"/>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button Grid.Column="5" Grid.RowSpan="2" Content="打开文件夹" Command="{Binding OpenCommand}"
                  Style="{StaticResource PrimaryButton}" MinWidth="112" Margin="10,4,4,4"/>

          <TextBlock Grid.Row="1" Text="原图目录" VerticalAlignment="Center" Margin="5" FontWeight="SemiBold"/>
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OriginalFolder, UpdateSourceTrigger=PropertyChanged}"/>
          <Button Grid.Row="1" Grid.Column="2" Content="浏览..." Command="{Binding BrowseOriginalCommand}" MinWidth="76"/>
          <TextBlock Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="2" Margin="18,5" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedTextBrush}" Text="可选，优先按相对路径匹配"/>
        </Grid>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.8*" MinWidth="210" MaxWidth="290"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="8.2*" MinWidth="480"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="2*" MinWidth="230" MaxWidth="300"/>
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Header="检出标签过滤">
          <ItemsControl ItemsSource="{Binding DetectionFilters}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="6,4"/>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </GroupBox>
        <TextBlock Grid.Row="1" Text="{Binding ImageCountSummary}" FontSize="14" FontWeight="SemiBold" Margin="10,10,5,7"/>
        <ListBox Grid.Row="2" ItemsSource="{Binding ItemsView}" SelectedItem="{Binding SelectedItem}"
                 Margin="6" ScrollViewer.HorizontalScrollBarVisibility="Auto">
          <ListBox.ItemTemplate><DataTemplate>
            <Grid>
              <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
              <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Row="1" Text="{Binding RelativePath}" Foreground="{StaticResource MutedTextBrush}"
                         FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </Grid>

      <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                    ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

      <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
              BorderThickness="1" CornerRadius="10" Padding="8" Margin="2,6">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <UniformGrid Columns="{Binding ViewerColumns}">
            <Grid Margin="3" Visibility="{Binding HasOriginalFolder, Converter={StaticResource BoolVisibility}}">
              <controls:ZoomImageView Source="{Binding OriginalImage}" Viewport="{Binding Viewport}"/>
              <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D90F766E"
                      CornerRadius="0,0,7,0" Padding="11,6">
                <TextBlock Text="原图" Foreground="White" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="未匹配到原图" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#9AA7B5" Visibility="{Binding OriginalImage, Converter={StaticResource NullVisibility}}"/>
            </Grid>
            <Grid Margin="3">
              <controls:ZoomImageView Source="{Binding ResultImage}" Viewport="{Binding Viewport}"/>
              <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="#D92563EB"
                      CornerRadius="0,0,7,0" Padding="11,6">
                <TextBlock Text="结果图" Foreground="White" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Text="未选择图片或图片无法读取" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#9AA7B5" Visibility="{Binding ResultImage, Converter={StaticResource NullVisibility}}"/>
            </Grid>
          </UniformGrid>
          <Grid Grid.Row="1" Margin="3,8,3,1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="←  上一张" Command="{Binding PreviousCommand}" MinWidth="96"/>
            <TextBlock Grid.Column="1" Text="滚轮缩放  ·  左键拖动  ·  双击复位  ·  方向键切换"
                       Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <Button Grid.Column="2" Content="下一张  →" Command="{Binding NextCommand}" MinWidth="96"/>
          </Grid>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                    ResizeBehavior="PreviousAndNext" Cursor="SizeWE"/>

      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
          <GroupBox Header="当前图片标签">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="4,2,4,8">
                <TextBlock Text="当前：" Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Text="{Binding SelectedItem.DetectionTag, TargetNullValue=未选择图片}"
                           Foreground="{StaticResource PrimaryBrush}" FontWeight="SemiBold"/>
              </StackPanel>
              <ItemsControl ItemsSource="{Binding DetectionTags}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate>
                  <Button Content="{Binding}" Style="{StaticResource TagChoiceButton}"
                          Command="{Binding DataContext.SelectDetectionTagCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"/>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <CheckBox Content="标注后自动跳转到下一张" IsChecked="{Binding AutoAdvance}" Margin="5,10,5,2"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="新增标签">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox Text="{Binding NewDetectionTag, UpdateSourceTrigger=PropertyChanged}" ToolTip="新检出标签"/>
              <Button Grid.Column="1" Content="添加检出" Command="{Binding AddDetectionTagCommand}"/>
            </Grid>
          </GroupBox>
          <GroupBox Header="实时统计">
            <ItemsControl ItemsSource="{Binding Statistics}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding}" Margin="4,3" Foreground="#344054"/>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>
          <GroupBox Header="按当前过滤导出">
            <StackPanel>
              <CheckBox Content="导出结果图" IsChecked="{Binding ExportResult}" Margin="5"/>
              <CheckBox Content="导出原图" IsChecked="{Binding ExportOriginal}" Margin="5"/>
              <Button Content="选择文件夹并导出" Command="{Binding ExportCommand}"
                      Style="{StaticResource PrimaryButton}" Margin="4,10,4,4"/>
            </StackPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0" Padding="16,8">
      <DockPanel>
        <ProgressBar DockPanel.Dock="Right" Width="110" Height="5" IsIndeterminate="True"
                     Foreground="{StaticResource PrimaryBrush}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}"/>
        <Ellipse Width="8" Height="8" Fill="#22A06B" Margin="0,0,8,0" DockPanel.Dock="Left"/>
        <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
